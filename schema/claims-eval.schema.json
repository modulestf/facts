{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims-eval.schema.json",
  "title": "mtf-facts claims-eval",
  "description": "The state of every behaviour trigger and every valid claim, from a ladder record, and the claims discarded with a reason. Refuted outranks covered.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "triggers", "capped", "claims", "discarded_claims"],
  "properties": {
    "schema_version": {"const": 1},
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
          "state": {"enum": ["inert", "verified", "covered", "refuted", "unverifiable"]},
          "reason": {"type": "string", "minLength": 1},
          "changes": {
            "type": "array",
            "description": "The (case, attribute) pairs of the tool's sweep that differ between base and head. explained means verified claims state both sides exactly, not that the change is compatible.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "case", "attribute", "explained", "inputs"],
              "properties": {
                "level": {"enum": ["L1", "L2", "L3"]},
                "case": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$"},
                "attribute": {"enum": ["known", "wholly_unknown", "unknown_mask", "length", "value", "sensitive", "redacted", "unknown_inputs", "action", "unchanged_vs_prior", "error"]},
                "explained": {"type": "boolean"},
                "explained_by": {"type": "array", "items": {"type": "string", "pattern": "^C-[0-9]{1,6}$"}, "description": "The claims that stated the sides of an explained change."},
                "inputs": {"type": "object"}
              }
            }
          },
          "complete": {"type": "boolean", "description": "For a trigger the sweep reads (L1, L2 or L3) that is not inert and not refuted: every level it selects ran with a valid control, every required case was observed at both revisions, every observation could be compared, and an L4 or compat level it also selects decided it. Absent for any other trigger."},
          "outstanding": {
            "description": "The differences of the sweep no verified claim explains, as '<trigger id>|<level>|<case id>|<attribute>', sorted. Present with complete, [] when none; absent, with complete false and no evidence_digest, when there are more than 256.",
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/difference_id"}
          },
          "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 over canonical JSON of the head and base commits, the outstanding ids, the base and head observations of their cases and the fixture hashes of the trigger's runs at their levels. Present only when outstanding is not empty."}
        },
        "dependentRequired": {"outstanding": ["complete"], "evidence_digest": ["outstanding"]},
        "if": {"type": "object", "required": ["outstanding"], "properties": {"outstanding": {"type": "array", "minItems": 1}}},
        "then": {"type": "object", "required": ["evidence_digest"], "properties": {"evidence_digest": {"type": "string"}}},
        "else": {"not": {"type": "object", "required": ["evidence_digest"], "properties": {"evidence_digest": {"type": "string"}}}}
      }
    },
    "capped": {"type": "integer", "minimum": 0, "description": "The behaviour report's capped: triggers past the cap, unverifiable."},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "state", "reason"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^C-[0-9]{1,6}$"},
          "state": {"enum": ["verified", "refuted", "unverifiable"]},
          "reason": {"type": "string", "minLength": 1},
          "trigger_id": {"type": "string", "pattern": "^T-[0-9]{3}$", "description": "The trigger params.node names."},
          "revision": {"enum": ["base", "head"]}
        }
      }
    },
    "discarded_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "reason"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^(C-[0-9]{1,6}|claims\\[[0-9]+\\])$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "difference_id": {"type": "string", "pattern": "^T-[0-9]{3}\\|L[1-4]\\|[A-Za-z0-9_.:-]{1,64}\\|[a-z_]{1,32}$"}
  }
}
