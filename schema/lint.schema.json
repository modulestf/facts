{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lint.schema.json",
  "title": "mtf-facts lint output",
  "description": "The JSON document that lint --json writes. index and interface_diff are optional.",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "manifest", "findings", "candidates"],
  "properties": {
    "envelope": {"$ref": "envelope.schema.json"},
    "manifest": {"$ref": "manifest.schema.json"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "index": {"type": "array", "items": {"$ref": "#/$defs/index_entry"}},
    "interface_diff": {"$ref": "https://github.com/modulestf/facts/schema/interface-diff.schema.json"}
  },
  "$defs": {
    "candidate": {
      "description": "A detected defect for a model or an author to confirm. Never a finding on its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "rule_id", "file", "line", "subject", "evidence", "evidence_complete"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^C-[0-9]{3,}$"},
        "rule_id": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "subject": {"description": "Scoped to the area: '<area>:<address>', such as '.:var.name'. A path rule's subject is its file or directory path.", "type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "evidence_complete": {"type": "boolean"}
      }
    },
    "evidence": {
      "description": "Evidence of a candidate, in the shape the facts bundle carries.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_lines", "base", "head", "schema_facts"],
      "properties": {
        "source_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision", "file", "line", "text"],
            "properties": {
              "revision": {"enum": ["head", "merge_base"]},
              "file": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 1},
              "text": {"type": "string"}
            }
          }
        },
        "base": {"description": "Base value as source text, null when absent at base.", "type": ["string", "null"]},
        "head": {"description": "Head value as source text, null when absent at head.", "type": ["string", "null"]},
        "schema_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider_source", "version", "type", "path", "state"],
            "properties": {
              "provider_source": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "type": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "state": {"enum": ["present", "absent", "deprecated", "unknown"]}
            }
          }
        }
      }
    },
    "index_entry": {
      "description": "The lines of one block or argument and its area-scoped subject. Entries nest; the innermost range that holds a line names that line's subject.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "start_line", "end_line", "subject"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "subject": {"description": "'<area>:<address>', such as '.:var.name'.", "type": "string", "minLength": 1}
      }
    },
    "finding": {
      "description": "The seven required fields of the reviewer findings schema.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "severity", "file", "line", "summary", "suggested_fix"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
        "rule_id": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "summary": {"type": "string", "minLength": 1},
        "suggested_fix": {"type": "string", "minLength": 1}
      }
    }
  }
}
