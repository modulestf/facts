{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lint.schema.json",
  "title": "mtf-facts lint output",
  "description": "The JSON document that lint --json writes. index, interface_diff and schema_coverage are optional; schema_coverage is written only when a schema handoff binds to the run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "manifest", "findings", "candidates"],
  "properties": {
    "envelope": {"$ref": "envelope.schema.json"},
    "manifest": {"$ref": "manifest.schema.json"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "index": {"type": "array", "items": {"$ref": "#/$defs/index_entry"}},
    "interface_diff": {"$ref": "https://github.com/modulestf/facts/schema/interface-diff.schema.json"},
    "schema_coverage": {"$ref": "https://github.com/modulestf/facts/schema/facts-bundle.schema.json#/properties/schema_coverage"}
  },
  "$defs": {
    "candidate": {
      "description": "A detected defect for a model or an author to confirm. Never a finding on its own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "rule_id", "file", "line", "subject", "evidence", "evidence_complete"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^C-[0-9]{3,}$"},
        "rule_id": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "subject": {"description": "Scoped to the area: '<area>:<address>', such as '.:var.name'. A path rule's subject is its file or directory path.", "type": "string", "minLength": 1},
        "evidence": {"$ref": "https://github.com/modulestf/facts/schema/facts-bundle.schema.json#/$defs/candidate/properties/evidence"},
        "evidence_complete": {"type": "boolean"}
      }
    },
    "index_entry": {
      "description": "The lines of one block or argument and its area-scoped subject. Entries nest; the innermost range that holds a line names that line's subject. Entries with the same lines, such as a one-line block and the argument in it, are in nesting order, outer first: the later entry names those lines.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "start_line", "end_line", "subject"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "subject": {"description": "'<area>:<address>', such as '.:var.name'.", "type": "string", "minLength": 1}
      }
    },
    "finding": {
      "description": "The seven required fields of the reviewer findings schema.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "severity", "file", "line", "summary", "suggested_fix"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
        "rule_id": {"type": "string", "pattern": "^[a-z]+\\.[a-z0-9]+(-[a-z0-9]+)*$"},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "file": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "summary": {"type": "string", "minLength": 1},
        "suggested_fix": {"type": "string", "minLength": 1}
      }
    }
  }
}
