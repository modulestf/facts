{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema-diff.schema.json",
  "title": "mtf-facts schema-diff report",
  "description": "Changes between two terraform providers schema -json files, for the resource and data source types a module tree uses. Each schema file is recorded by base name and SHA-256 only, so no host path is recorded. A provider the tree uses that either file lacks stops the run, so it has no report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "from",
    "to",
    "types",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "binary_sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "mtf-facts"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "from": {
      "description": "The schema file of the current provider version.",
      "$ref": "#/$defs/file"
    },
    "to": {
      "description": "The schema file of the target provider version.",
      "$ref": "#/$defs/file"
    },
    "types": {
      "description": "Every resource and data source type the tree uses, with the provider source it resolves to and the directories that use it, sorted by mode, type and source.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/type_use"
      }
    },
    "changes": {
      "description": "One row per change, in the order of types, then attributes before nested blocks, each by name. An added or removed block is one row; its contents are not listed.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "type",
          "provider_source",
          "path",
          "element",
          "change",
          "from",
          "to"
        ],
        "properties": {
          "mode": {
            "$ref": "#/$defs/mode"
          },
          "type": {
            "$ref": "#/$defs/type_name"
          },
          "provider_source": {
            "$ref": "#/$defs/provider_source"
          },
          "path": {
            "description": "Attribute, nested attribute and nested block names from the type down; empty for the type itself.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "element": {
            "description": "type: the type itself; argument: a required or optional attribute; attribute: a computed-only attribute; block: a nested block.",
            "enum": [
              "type",
              "argument",
              "attribute",
              "block"
            ]
          },
          "change": {
            "description": "added: in to only. removed: in from only. deprecated: deprecated in to and not in from. newly_required: required in to (min_items above zero for a block) and not in from, absent counting as not required. type_changed: an attribute's type changed, or it changed between a nested and a plain attribute, or its nested type's nesting mode changed. no_longer_settable: a required or optional attribute became computed-only. nesting_changed: a block's nesting_mode, min_items or max_items changed. sensitive_changed and write_only_changed: that flag of an attribute changed. absent: a type in neither file, whose provider both files have.",
            "enum": [
              "added",
              "removed",
              "deprecated",
              "newly_required",
              "type_changed",
              "no_longer_settable",
              "nesting_changed",
              "sensitive_changed",
              "write_only_changed",
              "absent"
            ]
          },
          "from": {
            "description": "The element in the from file, null where it is absent.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/value"
              }
            ]
          },
          "to": {
            "description": "The element in the to file, null where it is absent.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/value"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "element": {
                  "const": "type"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "array",
                  "maxItems": 0
                },
                "change": {
                  "enum": [
                    "added",
                    "removed",
                    "deprecated",
                    "absent"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "element": {
                  "const": "block"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1
                },
                "change": {
                  "enum": [
                    "added",
                    "removed",
                    "deprecated",
                    "newly_required",
                    "nesting_changed"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "element": {
                  "enum": [
                    "argument",
                    "attribute"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "array",
                  "minItems": 1
                },
                "change": {
                  "enum": [
                    "added",
                    "removed",
                    "deprecated",
                    "newly_required",
                    "type_changed",
                    "no_longer_settable",
                    "sensitive_changed",
                    "write_only_changed"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "description": "Base name of the file as given.",
          "type": "string",
          "pattern": "^[^/]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "mode": {
      "enum": [
        "resource",
        "data"
      ]
    },
    "type_name": {
      "type": "string",
      "minLength": 1
    },
    "provider_source": {
      "type": "string",
      "pattern": "^[^/A-Z]+/[^/A-Z]+/[^/A-Z]+$"
    },
    "type_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "type",
        "provider_source",
        "dirs"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "type": {
          "$ref": "#/$defs/type_name"
        },
        "provider_source": {
          "$ref": "#/$defs/provider_source"
        },
        "dirs": {
          "description": "Directories of the tree that use the type, relative to it, . for its root, sorted.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "value": {
      "description": "What one file says of the element: deprecated for every element; the attribute keys for an argument or attribute, with attribute_type (the type as the schema file writes it) or nested_type (the nesting mode of a nested type); the block keys for a block.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deprecated"
      ],
      "properties": {
        "deprecated": {
          "type": "boolean"
        },
        "attribute_type": {
          "description": "The cty type JSON of the schema file: a primitive type name, or an array such as [\"list\", \"string\"].",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 2
            }
          ]
        },
        "nested_type": {
          "enum": [
            "single",
            "list",
            "set",
            "map"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        },
        "computed": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        },
        "write_only": {
          "type": "boolean"
        },
        "nesting_mode": {
          "enum": [
            "single",
            "group",
            "list",
            "set",
            "map"
          ]
        },
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
