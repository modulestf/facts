{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "mtf-facts envelope",
  "description": "Binds a report to the binary, the rule registry, the input trees, the schema handoff and the module profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "head_sha", "merge_base_sha", "registry_sha256", "inputs", "schema_inputs", "profile_sha256"],
  "properties": {
    "schema_version": {"enum": [2]},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "binary_sha256"],
      "properties": {
        "name": {"enum": ["mtf-facts"]},
        "version": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "head_sha": {"$ref": "#/$defs/commit"},
    "merge_base_sha": {"$ref": "#/$defs/commit"},
    "registry_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "base"],
      "properties": {
        "head": {"$ref": "#/$defs/tree"},
        "base": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/tree"}]},
        "diff": {
          "description": "Present when the base tree was rebuilt from a diff, lint --diff: its format and the SHA-256 of the file as read. A file the diff gives no patch for is in base with kind no_patch.",
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256"],
          "properties": {
            "format": {"enum": ["github-files", "unified"]},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "schema_inputs": {"description": "Null when the run read no schema input. With raw provider schema files and no handoff, the handoff keys are null and schema_files lists the files.", "oneOf": [{"type": "null"}, {"$ref": "#/$defs/schema_inputs"}, {"$ref": "#/$defs/schema_files_inputs"}]},
    "profile_sha256": {"description": "SHA-256, lowercase hex, of the module profile input, null when the run read no valid profile. The preimage is one line per file the profile was built from, PROFILE.md and templates/<name> for each template its template-destinations block names, written as <sha256><two spaces><path><LF> with the path relative to the profile directory, the lines sorted by the bytes of path, with no other bytes: the layout of the schema handoff tree_hash.", "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "schema_inputs": {
      "description": "The schema handoff the run read: its own hash, the commits and .tf tree hashes it records, and a hash per raw provider schema file.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_sha256", "head_sha", "merge_base_sha", "tree_hashes", "schema_files"],
      "properties": {
        "handoff_sha256": {"description": "SHA-256 of the handoff file as read, gzipped or not: a gzipped and a plain copy of the same document hash differently, so the host hashes the form it passes.", "$ref": "#/$defs/sha256"},
        "head_sha": {"$ref": "#/$defs/commit_sha"},
        "merge_base_sha": {"$ref": "#/$defs/commit_sha"},
        "tree_hashes": {
          "description": "The handoff's tree_hash per revision.",
          "type": "object",
          "additionalProperties": false,
          "required": ["head", "merge_base"],
          "properties": {
            "head": {"$ref": "#/$defs/sha256"},
            "merge_base": {"$ref": "#/$defs/sha256"}
          }
        },
        "schema_files": {"$ref": "#/$defs/schema_files"}
      }
    },
    "schema_files_inputs": {
      "description": "Raw provider schema files read with no schema handoff: the handoff keys are null and every file has a hash.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_sha256", "head_sha", "merge_base_sha", "tree_hashes", "schema_files"],
      "properties": {
        "handoff_sha256": {"type": "null"},
        "head_sha": {"type": "null"},
        "merge_base_sha": {"type": "null"},
        "tree_hashes": {"type": "null"},
        "schema_files": {"$ref": "#/$defs/schema_files", "type": "array", "minItems": 1}
      }
    },
    "schema_files": {
      "description": "SHA-256 of each raw provider schema file as read, in the order given, with its base name: no directory, so no host path is recorded and the same file read from another directory records the same entry. Two files with one base name stop the run.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/]+$"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_sha256", "files"],
      "properties": {
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"enum": ["file", "symlink", "special", "unreadable", "oversize", "no_patch"]},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  }
}
