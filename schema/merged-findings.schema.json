{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/modulestf/facts/schema/merged-findings.schema.json",
  "title": "Merged findings",
  "description": "The findings the host merge produces from the facts bundle, the confirmer outputs and the lead's reply. Each finding is the seven finding fields plus host-owned provenance. source is the channel: tool for a bundle tool finding, a candidate a small or mid confirmer confirmed, or an answered severity_needed entry; llm for an entry of the lead's findings or a candidate the lead confirmed; host for a finding the host builds itself, a severity_needed fallback or a review.check-not-run for a candidate. candidate_id and confirmed_by are a pair. confirmed_by is one value: when dedup merges findings, the cheapest confirmer wins, small before mid before lead. Subjects are scoped to their area as '<area>:<address>', such as '.:var.retention_days', or are a file path for a path rule. The schema checks the shape; the host checks that a file-level subject is the finding's file.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/merged_finding"
  },
  "$defs": {
    "merged_finding": {
      "type": "object",
      "$ref": "finding.schema.json",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "tool",
            "llm",
            "host"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "candidate_id": {
          "$ref": "facts-bundle.schema.json#/$defs/candidate_id"
        },
        "confirmed_by": {
          "description": "The class that confirmed the candidate. One value, never a list.",
          "enum": [
            "small",
            "mid",
            "lead"
          ]
        },
        "predates_change": {
          "description": "Present, and true, on a tool finding whose rule also fires on the base with the same subject: the defect is older than the change. Never on an llm or host finding.",
          "const": true
        },
        "explains": {
          "$ref": "finding.schema.json#/$defs/explains"
        },
        "evidence_digest": {
          "$ref": "finding.schema.json#/$defs/evidence_digest"
        }
      },
      "dependentRequired": {
        "candidate_id": [
          "confirmed_by"
        ],
        "confirmed_by": [
          "candidate_id"
        ]
      },
      "unevaluatedProperties": false,
      "allOf": [
        {
          "description": "tool: subject required, confirmed by small or mid only, never a review.* rule, which is an llm rule.",
          "if": {
            "properties": {
              "source": {
                "const": "tool"
              }
            }
          },
          "then": {
            "required": [
              "subject"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "not": {
                  "pattern": "^review\\."
                }
              },
              "subject": {
                "$ref": "#/$defs/plain_subject"
              },
              "confirmed_by": {
                "enum": [
                  "small",
                  "mid"
                ]
              }
            }
          }
        },
        {
          "description": "llm: subject optional; a candidate the lead confirmed carries subject, candidate_id and confirmed_by lead.",
          "if": {
            "properties": {
              "source": {
                "const": "llm"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "$ref": "#/$defs/plain_subject"
              },
              "confirmed_by": {
                "const": "lead"
              }
            },
            "dependentRequired": {
              "candidate_id": [
                "subject"
              ]
            }
          }
        },
        {
          "description": "host, review.check-not-run for a candidate: subject '<candidate rule_id>@<area>:<address>' or '<candidate rule_id>@<file>', no candidate_id.",
          "if": {
            "properties": {
              "source": {
                "const": "host"
              },
              "rule_id": {
                "const": "review.check-not-run"
              }
            }
          },
          "then": {
            "required": [
              "subject"
            ],
            "properties": {
              "subject": {
                "pattern": "^(compat|coverage|structure|examples|profile|scope|review|claim)\\.[a-z0-9]+(-[a-z0-9]+)*@.",
                "type": "string"
              },
              "candidate_id": false
            }
          }
        },
        {
          "description": "host, any other rule: a severity_needed fallback, which keeps its candidate_id and the confirmer's class.",
          "if": {
            "properties": {
              "source": {
                "const": "host"
              },
              "rule_id": {
                "not": {
                  "const": "review.check-not-run"
                }
              }
            }
          },
          "then": {
            "required": [
              "subject",
              "candidate_id"
            ],
            "properties": {
              "subject": {
                "$ref": "#/$defs/plain_subject"
              },
              "confirmed_by": {
                "enum": [
                  "small",
                  "mid"
                ]
              }
            }
          }
        },
        {
          "description": "explains and evidence_digest only on a compat.expression-behaviour-changed or claim.* finding.",
          "if": {
            "type": "object",
            "required": [
              "rule_id"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "not": {
                  "$ref": "finding.schema.json#/$defs/explaining_rule"
                }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "explains": false,
              "evidence_digest": false
            }
          }
        },
        {
          "description": "predates_change only on a tool finding.",
          "if": {
            "type": "object",
            "required": [
              "predates_change"
            ],
            "properties": {
              "predates_change": {
                "const": true
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "const": "tool"
              }
            }
          }
        }
      ]
    },
    "subject": {
      "description": "'<area>:<address>', a file or directory path, or, for a host review.check-not-run, either one prefixed with the candidate's rule_id and '@'.",
      "type": "string",
      "minLength": 1
    },
    "plain_subject": {
      "description": "A subject with no rule_id prefix. Only a host review.check-not-run has one.",
      "type": "string",
      "not": {
        "pattern": "^(compat|coverage|structure|examples|profile|scope|review|claim)\\.[a-z0-9]+(-[a-z0-9]+)*@"
      }
    }
  }
}
