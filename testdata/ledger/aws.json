{
  "format_version": "1.0",
  "provider_schemas": {
    "registry.terraform.io/hashicorp/aws": {
      "provider": {"version": 0, "block": {}},
      "resource_schemas": {
        "aws_example_bucket": {
          "version": 0,
          "block": {
            "attributes": {
              "arn": {"type": "string", "computed": true},
              "id": {"type": "string", "optional": true, "computed": true},
              "legacy_acl": {"type": "string", "optional": true, "deprecated": true},
              "name": {"type": "string", "required": true},
              "password": {"type": "string", "optional": true, "sensitive": true},
              "rules": {"nested_type": {"nesting_mode": "set", "attributes": {"prefix": {"type": "string", "optional": true}}}, "optional": true},
              "tags": {"type": ["map", "string"], "optional": true}
            },
            "block_types": {
              "logging": {
                "nesting_mode": "list",
                "max_items": 1,
                "block": {"attributes": {"target": {"type": "string", "required": true}}}
              }
            }
          }
        }
      },
      "data_source_schemas": {
        "aws_example_region": {
          "version": 0,
          "block": {
            "attributes": {
              "id": {"type": "string", "optional": true, "computed": true},
              "name": {"type": "string", "computed": true}
            }
          }
        }
      }
    }
  }
}
